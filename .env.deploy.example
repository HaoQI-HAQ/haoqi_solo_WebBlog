# 复制为 .env.deploy 后按实际环境配置；真实 .env.* 已忽略，不能提交凭据。
# VITE_* 会进入浏览器，只能放公开地址，不能放云服务密钥。
VITE_BASE=/

# auto：没有媒体地址时构建完整包；有地址时构建外置包。
# full：完整包，必须保持 VITE_MEDIA_BASE 为空。
# external：外置包，没有有效 HTTP(S) 地址就停止构建。
VITE_MEDIA_MODE=auto
VITE_MEDIA_BASE=

# 尚未选择托管时留空。正式发布时填写实际 HTTPS 根地址。
# 未配置时不输出虚假的 canonical / sitemap，不影响本地构建。
VITE_SITE_URL=

# 可选的项目内构建输出目录，默认 dist。不要指定源文件或 public 目录。
# VITE_OUT_DIR=dist
